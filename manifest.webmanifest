{
  "name": "QR Visualizer",
  "short_name": "QR Visualizer",
  "description": "See every section of a QR code, live. Camera-based QR anatomy visualizer.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1020",
